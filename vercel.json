{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "webhook-dispatch": {
      "schedule": "* * * * *",
      "path": "/api/internal/webhooks/dispatch"
    },
    "event-consumers": {
      "schedule": "* * * * *",
      "path": "/api/internal/events/process"
    },
    "calendar-maintenance": {
      "schedule": "17 * * * *",
      "path": "/api/calendar/machine/maintenance"
    }
  }
}
