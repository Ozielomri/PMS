# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings → API). Use a US region project (X-10).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# "on" once Supabase image transformations are enabled (Pro plan): photos then load resized.
# Off (default): the original files are shown.
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=off
# Server only: secret (service role) key, used by the webhook/event workers.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public URL of this app, used in email links and invitation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PMS_ENCRYPTION_KEY=
# Bearer token the scheduler sends to /api/internal/*. Generate like the key above.
CRON_SECRET=

# Local development only: allow http:// and private-network webhook URLs.
# WEBHOOKS_ALLOW_PRIVATE_NETWORKS=1

# Tests: a Postgres superuser connection; the db test suite creates and drops database pms_test.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
